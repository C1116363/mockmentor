# Copy to .env.deploy and fill in. That file is gitignored.
#
#   docker compose --env-file .env.deploy up -d --build
#
# Managed platforms do not read this file - set the same names in their
# dashboard instead.

# ---- required ----

# MySQL root password. Any long random string; nothing else needs to know it.
DB_PASSWORD=

# openssl rand -base64 32
#
# NOT the value committed in application.properties. That one is public, so
# anyone who can read the repo could forge a token for any account, admin
# included - and nothing would look wrong.
JWT_SECRET=

# Where the browser reaches the API. Baked into the frontend bundle at build
# time, so a change here needs a rebuild.
VITE_API_URL=https://api.example.com/api

# Every origin allowed to call the API. Comma-separated, no trailing slashes.
# Get this wrong and the app loads while every request fails, though curl works
# perfectly - it is the single most common "my deploy is broken" cause.
CORS_ORIGINS=https://app.example.com,https://example.com

# Where password-reset links point. The frontend, never the API.
FRONTEND_URL=https://app.example.com

# ---- optional ----

# update for the first boot to create the schema, then switch to validate.
DDL_AUTO=update

# Host ports. Change if something already holds them, or if a reverse proxy in
# front expects something else.
BACKEND_PORT=8080
FRONTEND_PORT=5173
WEBSITE_PORT=3000

# Manual UPI works with none of the Razorpay values set.
UPI_ID=yourname@okhdfcbank
UPI_PAYEE=Your Name

PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# log prints reset emails to the container log; smtp really sends them.
MAIL_PROVIDER=log
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

GITHUB_TOKEN=
