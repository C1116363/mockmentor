# Copy to .env next to docker-compose.yml, then fill in the first two.
#   cp .env.deploy.example .env

# ---- Required ----
# Any strong password; the database is not exposed outside the compose network.
DB_PASSWORD=

# openssl rand -base64 32
# NEVER the committed default - anyone who can read the repo could then forge
# a token for any account, including admin.
JWT_SECRET=

# ---- URLs: set these to your real domains before going public ----
VITE_API_URL=http://localhost:8080/api
CORS_ORIGINS=http://localhost:8081
FRONTEND_URL=http://localhost:8081

# ---- After the first successful start ----
# DDL_AUTO=validate

# ---- Where the money goes ----
UPI_ID=yourname@okhdfcbank
UPI_PAYEE=Your Name

# ---- Optional: card payments. Manual UPI works without any of this. ----
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional: real email. Default prints the reset link to the log. ----
MAIL_PROVIDER=log
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
