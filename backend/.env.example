# Copy this to .env and fill in your own values.
# .env is gitignored, so nothing in here ever reaches GitHub.
#
#   cp backend/.env.example backend/.env

# ---- Database ----
DB_USER=root
DB_PASSWORD=

# ---- Manual UPI (works with no gateway, no KYC, no fees) ----
# Your own UPI ID. This is where the money actually lands.
UPI_ID=yourname@okhdfcbank
UPI_PAYEE=Your Name

# ---- Payment provider ----
# manual   = pay-by-UPI + a screenshot an admin checks. The default.
# razorpay = real card / netbanking / UPI checkout. Needs the three keys below.
#
# Leave this on "manual" until all three keys are filled in. Switching early is
# harmless - the app notices the keys are missing and keeps offering UPI - but
# there is no reason to.
PAYMENT_PROVIDER=manual

# ---- Razorpay ----
# All three are needed. With any of them blank, gateway checkout stays off.
#
# 1. KEY ID + KEY SECRET
#    Razorpay Dashboard -> Account & Settings -> API Keys -> Generate Key.
#    The SECRET is shown exactly once, at that moment. Copy it now; if you lose
#    it you have to regenerate the pair.
#    Test keys start rzp_test_ and move no real money. Start there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 2. WEBHOOK SECRET
#    Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook.
#    You TYPE this one in yourself - it is not generated. Any long random
#    string; paste the same value in both places.
#
#      URL:     https://your-domain/api/webhooks/razorpay
#      Events:  order.paid, payment.captured, payment.failed
#
#    This is NOT the key secret. Using the key secret here makes every webhook
#    fail its signature check, and the symptom - a stream of 403s - looks like
#    somebody is attacking you.
#
#    Razorpay cannot reach localhost. For development, run
#      cloudflared tunnel --url http://localhost:8080
#    and use the https URL it prints.
RAZORPAY_WEBHOOK_SECRET=

# ---- GitHub (live project collaborator invites) ----
# Only needed if app.github.provider=api. Leave blank for the manual flow.
GITHUB_TOKEN=
